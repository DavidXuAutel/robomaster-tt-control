# Copy to config.env and edit. Sourced by run_all.sh.
# Client runs on the 8xH100 (a25689@10.239.121.21:31126);
# AirSim renderer runs on the 4090 (10.229.20.125).

# --- AirSim renderer (4090) ---
export AIRSIM_HOST=10.229.20.125
export AIRSIM_PORT=41451            # AirSim RPC default; change if the renderer uses another port
export AIRSIM_CAMERA=0              # camera id for Scene/Depth grabs (try "front_center" if 0 fails)

# --- OpenFly clone + scene (needed for T1 real-render check) ---
export OPENFLY_ROOT=$HOME/aerial_eval_cache/OpenFly-Platform   # <-- confirm actual path on this host
export ENV_NAME=env_airsim_16

# --- optional: repo checkout for T3 regression smoke ---
# export REPO_ROOT=$HOME/robomaster-tt-control
# export ANN=$HOME/aerial_cache_shared/orchestration/heldout/seen_airsim16_m1a20.json

# --- L2f continuous-frame probe (optical flow / multi-frame depth readiness) ---
export L2F_N=10                 # number of Scene frames to capture
export L2F_INTERVAL_S=0.05      # target inter-frame interval (~20 Hz)
export L2F_MIN_FPS=5.0          # fail continuous_frames if achieved fps below this

# --- output ---
export OUT=./artifacts/sim_capability_report.json
